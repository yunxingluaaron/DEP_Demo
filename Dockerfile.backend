# Backend Dockerfile for Flask + PyTorch Application
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies (if needed for PyTorch)
RUN apt-get update && apt-get install -y \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first (for better caching)
COPY backend/requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy the entire backend folder
COPY backend/ .

# Copy the model file (adjust the path as needed)
# If your model is in a different location, modify this line
COPY model/ab_agent_model_2.pth /app/model/ab_agent_model_2.pth

# Set environment variables
ENV FLASK_APP=app.py
ENV PYTHONUNBUFFERED=1
ENV MODEL_PATH=/app/model/ab_agent_model_2.pth

# Expose port 5000
EXPOSE 5000

# Use gunicorn for production (install it in requirements.txt)
# CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "2", "--timeout", "120", "app:app"]

# Or use Flask directly (not recommended for production but simpler)
CMD ["python", "app.py"]
